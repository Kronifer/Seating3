FROM alpine:latest
RUN apk add postfix postfix-ldap
COPY test.cf /etc/postfix/main.cf
COPY ssl-cert-snakeoil.pem /etc/ssl/certs/ssl-cert-snakeoil.pem
COPY ssl-cert-snakeoil.key /etc/ssl/private/ssl-cert-snakeoil.key
RUN echo "maillog_file = /dev/stdout" >> /etc/postfix/main.cf
CMD postmap /etc/postfix/aliases && /usr/sbin/postfix start-fg
